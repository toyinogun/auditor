# Copy to .env.local and fill in. Never commit real values.

# Claude access, server only. Optional when DEMO_MODE=true.
ANTHROPIC_API_KEY=
# Extraction model id.
ANTHROPIC_MODEL=claude-sonnet-5
# Shared secret the n8n webhook sends in the X-Ingest-Secret header.
INGEST_SECRET=
# Folder for auditor.db and uploads/ (/data on k3s).
DATA_DIR=./data
# true on the public demo: uploads limited to the sample files.
DEMO_MODE=false
# Per file upload limit in megabytes.
MAX_UPLOAD_MB=10
